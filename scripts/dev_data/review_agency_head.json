[
    ["DEFINE", ["open", "status in ('ack', 'processed', 'appealing')"]],
    ["DEFINE", ["window", "now() - interval '24 months'"]],
    ["DEFINE", ["embargoed", "embargo_status <> 'public' and not (embargo_status = 'embargo' and coalesce(date_embargo < current_date, false))"]],
    ["DEFINE", ["embargoed_foia", "select id from foia_foiarequest where {{embargoed}}"]],
    ["DEFINE", ["embargoed_users", "select user_id from foia_foiacomposer where id in (select composer_id from foia_foiarequest where {{embargoed}})"]],
    ["PK", ["task_reviewagencytask", "task_ptr_id"]],
    ["KEEP_LOCAL", ["auth_user"]],
    ["KEEP_LOCAL", ["accounts_profile"]],
    ["KEEP_LOCAL", ["organization_organization"]],
    ["KEEP_LOCAL", ["organization_membership"]],
    ["KEEP_LOCAL", ["organization_entitlement"]],
    ["SKIP_KEPT", ["accounts_profile", "user_id", "auth_user", "username"]],
    ["SKIP_KEPT", ["organization_membership", "user_id", "auth_user", "username"]],

    ["ALL", ["jurisdiction_jurisdiction"]],
    ["ALL", ["jurisdiction_law"]],
    ["ALL", ["agency_agencytype"]],

    ["SQL", ["agency_agency", "id in (select f.agency_id from foia_foiarequest f join communication_emailaddress e on e.id = f.email_id where f.status in ('ack', 'processed', 'appealing') and e.status = 'error' and exists (select 1 from task_reviewagencytask r join task_task t on t.id = r.task_ptr_id where r.agency_id = f.agency_id and not t.resolved) group by f.agency_id order by count(*) desc limit 30)"]],

    ["BACK", ["agency_agency_types", "agency_id", "agency_agency"]],
    ["BACK", ["agency_agencyemail", "agency_id", "agency_agency"]],
    ["FORE", ["agency_agencyemail", "email_id", "communication_emailaddress"]],
    ["BACK", ["agency_agencyphone", "agency_id", "agency_agency"]],
    ["FORE", ["agency_agencyphone", "phone_id", "communication_phonenumber"]],
    ["BACK", ["agency_agencyaddress", "agency_id", "agency_agency"]],
    ["FORE", ["agency_agencyaddress", "address_id", "communication_address"]],
    ["FORE", ["agency_agency", "portal_id", "portal_portal"]],
    ["FORE", ["agency_agency", "form_id", "agency_agencyrequestform"]],
    ["FORE", ["agency_agency", "user_id", "auth_user"]],

    ["BACK", ["task_reviewagencytask", "agency_id", "agency_agency", "task_ptr_id in (select id from task_task where not resolved or date_done > {{window}})"]],
    ["FORE", ["task_reviewagencytask", "task_ptr_id", "task_task"]],
    ["FORE", ["task_task", "assigned_id", "auth_user"]],
    ["FORE", ["task_task", "resolved_by_id", "auth_user"]],

    ["BACK", ["foia_foiarequest", "agency_id", "agency_agency", "{{open}}"]],
    ["FORE", ["foia_foiarequest", "email_id", "communication_emailaddress"]],
    ["FORE", ["foia_foiarequest", "fax_id", "communication_phonenumber"]],
    ["FORE", ["foia_foiarequest", "address_id", "communication_address"]],
    ["FORE", ["foia_foiarequest", "portal_id", "portal_portal"]],
    ["FORE", ["foia_foiarequest", "proxy_id", "auth_user"]],
    ["BACK", ["foia_foiarequest_cc_emails", "foiarequest_id", "foia_foiarequest"]],
    ["FORE", ["foia_foiarequest_cc_emails", "emailaddress_id", "communication_emailaddress"]],
    ["BACK", ["foia_trackingnumber", "foia_id", "foia_foiarequest"]],
    ["FORE", ["foia_foiarequest", "composer_id", "foia_foiacomposer"]],
    ["FORE", ["foia_foiacomposer", "user_id", "auth_user"]],

    ["BACK", ["foia_foiacommunication", "foia_id", "foia_foiarequest", "datetime > {{window}}"]],
    ["FORE", ["foia_foiacommunication", "from_user_id", "auth_user"]],
    ["FORE", ["foia_foiacommunication", "to_user_id", "auth_user"]],

    ["BACK", ["communication_emailcommunication", "communication_id", "foia_foiacommunication"]],
    ["FORE", ["communication_emailcommunication", "from_email_id", "communication_emailaddress"]],
    ["BACK", ["communication_emailcommunication_to_emails", "emailcommunication_id", "communication_emailcommunication"]],
    ["FORE", ["communication_emailcommunication_to_emails", "emailaddress_id", "communication_emailaddress"]],
    ["BACK", ["communication_emailcommunication_cc_emails", "emailcommunication_id", "communication_emailcommunication"]],
    ["FORE", ["communication_emailcommunication_cc_emails", "emailaddress_id", "communication_emailaddress"]],
    ["BACK", ["communication_emailerror", "email_id", "communication_emailcommunication"]],
    ["FORE", ["communication_emailerror", "recipient_id", "communication_emailaddress"]],
    ["BACK", ["communication_emailopen", "email_id", "communication_emailcommunication"]],
    ["FORE", ["communication_emailopen", "recipient_id", "communication_emailaddress"]],

    ["BACK", ["communication_faxcommunication", "communication_id", "foia_foiacommunication"]],
    ["FORE", ["communication_faxcommunication", "to_number_id", "communication_phonenumber"]],
    ["BACK", ["communication_faxerror", "fax_id", "communication_faxcommunication"]],
    ["FORE", ["communication_faxerror", "recipient_id", "communication_phonenumber"]],

    ["BACK", ["communication_mailcommunication", "communication_id", "foia_foiacommunication"]],
    ["BACK", ["communication_mailevent", "mail_id", "communication_mailcommunication"]],
    ["FORE", ["communication_mailcommunication", "from_address_id", "communication_address"]],
    ["FORE", ["communication_mailcommunication", "to_address_id", "communication_address"]],

    ["BACK", ["communication_portalcommunication", "communication_id", "foia_foiacommunication"]],
    ["FORE", ["communication_portalcommunication", "portal_id", "portal_portal"]],
    ["BACK", ["communication_webcommunication", "communication_id", "foia_foiacommunication"]],

    ["BACK", ["accounts_profile", "user_id", "auth_user"]],
    ["BACK", ["organization_membership", "user_id", "auth_user"]],
    ["FORE", ["organization_membership", "organization_id", "organization_organization"]],
    ["FORE", ["foia_foiacomposer", "organization_id", "organization_organization"]],
    ["FORE", ["organization_organization", "entitlement_id", "organization_entitlement"]],

    ["CLEAN_KEY", ["agency_agency", "parent_id", "agency_agency"]],
    ["CLEAN_KEY", ["agency_agency", "appeal_agency_id", "agency_agency"]],
    ["CLEAN_KEY", ["jurisdiction_jurisdiction", "appeal_agency_id", "agency_agency"]],
    ["CLEAN_KEY", ["foia_foiarequest", "crowdfund_id", "crowdfund_crowdfund"]],
    ["CLEAN_KEY", ["foia_foiacomposer", "parent_id", "foia_foiacomposer"]],
    ["CLEAN_KEY", ["foia_foiacommunication", "likely_foia_id", "foia_foiarequest"]],
    ["CLEAN_KEY", ["accounts_profile", "agency_id", "agency_agency"]],
    ["CLEAN_KEY", ["organization_organization", "parent_id", "organization_organization"]],
    ["CLEAN_KEY", ["organization_organization", "merged_id", "organization_organization"]],

    ["CLEAN_FIELD", ["auth_user", "email"]],
    ["CLEAN_FIELD", ["auth_user", "password", "!"]],
    ["CLEAN_FIELD", ["accounts_profile", "address1"]],
    ["CLEAN_FIELD", ["accounts_profile", "address2"]],
    ["CLEAN_FIELD", ["accounts_profile", "city"]],
    ["CLEAN_FIELD", ["accounts_profile", "state"]],
    ["CLEAN_FIELD", ["accounts_profile", "zip_code"]],
    ["CLEAN_FIELD", ["accounts_profile", "phone"]],
    ["CLEAN_FIELD", ["foia_foiarequest", "portal_password"]],
    ["CLEAN_FIELD", ["foia_foiarequest", "access_key"]],
    ["CLEAN_FIELD", ["foia_foiacommunication", "priv_from_who"]],
    ["CLEAN_FIELD", ["foia_foiacommunication", "priv_to_who"]],
    ["CLEAN_FIELD", ["organization_organization", "card"]],

    ["REDACT_WHERE", ["foia_foiarequest", "title", "{{embargoed}}", "Embargoed request"]],
    ["REDACT_WHERE", ["foia_foiarequest", "slug", "{{embargoed}}", "embargoed-{pk}"]],
    ["REDACT_WHERE", ["foia_foiacomposer", "title", "id in (select composer_id from foia_foiarequest where {{embargoed}})", "Embargoed request"]],
    ["REDACT_WHERE", ["foia_foiacomposer", "slug", "id in (select composer_id from foia_foiarequest where {{embargoed}})", "embargoed-{pk}"]],
    ["REDACT_WHERE", ["foia_foiacomposer", "requested_docs", "id in (select composer_id from foia_foiarequest where {{embargoed}})", ""]],
    ["REDACT_WHERE", ["foia_foiacommunication", "communication", "foia_id in ({{embargoed_foia}})", ""]],
    ["REDACT_WHERE", ["foia_foiacommunication", "subject", "foia_id in ({{embargoed_foia}})", ""]],
    ["REDACT_WHERE", ["foia_foiacommunication", "from_who", "foia_id in ({{embargoed_foia}})", ""]],
    ["REDACT_WHERE", ["foia_foiacommunication", "to_who", "foia_id in ({{embargoed_foia}})", ""]],
    ["REDACT_WHERE", ["auth_user", "first_name", "id in ({{embargoed_users}})", ""]],
    ["REDACT_WHERE", ["auth_user", "last_name", "id in ({{embargoed_users}})", ""]],
    ["REDACT_WHERE", ["auth_user", "username", "id in ({{embargoed_users}})", "embargoed-{pk}"]],
    ["REDACT_WHERE", ["accounts_profile", "full_name", "user_id in ({{embargoed_users}})", ""]],
    ["REDACT_WHERE", ["organization_organization", "name", "individual and id in (select organization_id from organization_membership where user_id in ({{embargoed_users}}))", "Embargoed requester"]],
    ["REDACT_WHERE", ["organization_organization", "slug", "individual and id in (select organization_id from organization_membership where user_id in ({{embargoed_users}}))", "embargoed-{pk}"]],
    ["REDACT_WHERE", ["communication_emailaddress", "name", "id in (select from_email_id from communication_emailcommunication where communication_id in (select id from foia_foiacommunication where not response and foia_id in ({{embargoed_foia}}))) or id in (select emailaddress_id from communication_emailcommunication_to_emails where emailcommunication_id in (select id from communication_emailcommunication where communication_id in (select id from foia_foiacommunication where response and foia_id in ({{embargoed_foia}}))))", ""]]
]
